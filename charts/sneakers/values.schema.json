{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Sneakers umbrella chart values",
  "description": "Each service and third-party block is checked by its own chart's schema; this one covers the umbrella's own keys.",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "bundledSecrets"],
  "definitions": {
    "toggle": {
      "type": "object",
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "required": ["host", "environment", "logLevel", "logFormat"],
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)+$"
        },
        "environment": { "type": "string", "minLength": 1 },
        "logLevel": { "enum": ["trace", "debug", "info", "warn", "error", "fatal", "panic", "disabled"] },
        "logFormat": { "enum": ["json", "console", "pretty", "both"] },
        "otlpEndpoint": { "type": "string" }
      }
    },
    "bundledSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "bundledNetworkPolicies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "kratosPublicFrom": { "type": "array", "items": { "type": "object" } },
        "hydraPublicFrom": { "type": "array", "items": { "type": "object" } }
      }
    },
    "identity": { "$ref": "#/definitions/toggle" },
    "vault": { "$ref": "#/definitions/toggle" },
    "workflow": { "$ref": "#/definitions/toggle" },
    "audit": { "$ref": "#/definitions/toggle" },
    "notify": { "$ref": "#/definitions/toggle" },
    "connector": { "$ref": "#/definitions/toggle" },
    "sshbroker": { "$ref": "#/definitions/toggle" },
    "gateway": { "$ref": "#/definitions/toggle" },
    "mcp": { "$ref": "#/definitions/toggle" },
    "postgres": { "$ref": "#/definitions/toggle" },
    "valkey": { "$ref": "#/definitions/toggle" },
    "kratos": { "$ref": "#/definitions/toggle" },
    "hydra": { "$ref": "#/definitions/toggle" },
    "tests": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" }
          }
        }
      }
    }
  }
}
