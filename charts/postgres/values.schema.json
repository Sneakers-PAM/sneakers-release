{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Bundled PostgreSQL values",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "auth", "databases", "persistence", "resources"],
  "properties": {
    "enabled": { "type": "boolean" },
    "global": { "type": "object" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "username", "passwordKey", "superuserPasswordKey"],
      "properties": {
        "existingSecret": { "type": "string" },
        "username": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
        "passwordKey": { "type": "string", "minLength": 1 },
        "superuserPasswordKey": { "type": "string", "minLength": 1 }
      }
    },
    "databases": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size"],
      "properties": {
        "size": { "type": "string", "minLength": 1 },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "resources": { "type": "object", "required": ["requests", "limits"] },
    "podSecurityContext": {
      "type": "object",
      "properties": { "runAsNonRoot": { "const": true } }
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "allowPrivilegeEscalation": { "const": false },
        "readOnlyRootFilesystem": { "const": true }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "from": {
          "type": "array",
          "items": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
        }
      }
    },
    "podAnnotations": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  }
}
